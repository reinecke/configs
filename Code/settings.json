{
    "telemetry.enableTelemetry": false,

    "window.titleBarStyle": "native",
    "workbench.editor.showTabs": false,
    "workbench.editor.swipeToNavigate": true,
    "editor.lineNumbers": "relative",
    "editor.rulers": [79, 120],
    "editor.autoClosingBrackets" : "never",
    "editor.quickSuggestions": {
        "other": true,
        "comments": false,
        "strings": true
    },
    "[json]": {
        "editor.tabSize": 2
    },

    "debug.inlineValues": false,

    // Python environment defaults
    "python.linting.flake8Enabled": true,
    "python.linting.pylintEnabled": false,
    "python.venvPath": "~/envs",
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    //"python.testing.pytestPath": "pytest",
    "python.testing.nosetestsEnabled": false,
    "autoDocstring.docstringFormat": "sphinx",

    // Modes: normal, insert, replace, visual, visualline, and visualblock
    // Cursors: line, block, underline, line-thin, block-outline, and underline-thin
    "vim.cursorStylePerMode" : {
        "normal": "block",
        "insert": "line-thin",
        "replace": "block-outline"
    },

    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/*~": true,
        "**/*.pyc": true,
        "*.egg-info": true,
        "**/.flake8": true,
        ".coverage": true,
        "**/__pycache__": true
    },

    "files.associations": {
        "cloudformation.template": "yaml",
    },

    "git.autofetch": true,
    "git.defaultCloneDirectory": "~/Projects",
    "git.promptToSaveFilesBeforeCommit": true,

    // Java
    "java.import.gradle.enabled": true,
    "java.autobuild.enabled": true,
    "java.configuration.checkProjectSettingsExclusions": false,
    "editor.suggestSelection": "first",
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
    "python.jediEnabled": false,
    "python.showStartPage": false,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "editor.renderControlCharacters": true,
    "editor.autoClosingQuotes": "never",
    "editor.autoSurround": "never"
}